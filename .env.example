# School configuration
#
# Copy this file to `.env.local` and fill in your school's details.
# Next.js exposes only NEXT_PUBLIC_* variables to the browser, so those are
# the ones the app reads at runtime; the bare names act as a server-side
# fallback.

NEXT_PUBLIC_SCHOOL_DOMAIN=@yourschool.edu
NEXT_PUBLIC_SCHOOL_NAME=Your School Name

SCHOOL_DOMAIN=@yourschool.edu
SCHOOL_NAME=Your School Name
